# Generated by `make env` (scripts/gen-local-env.sh): random, local-only values.
# Copy this file to .env only if you want to set them by hand.
AGENTSTUDIO_SESSION_SECRET=replace-with-64-random-characters
AGENTSTUDIO_API_KEY_PEPPER=replace-with-64-different-random-characters
# Base64 of 32 random bytes: openssl rand -base64 32
AGENTSTUDIO_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
# Password of every demo account `make demo` creates.
AGENTSTUDIO_DEMO_PASSWORD=replace-me

# Optional overrides
# AGENTSTUDIO_WEB_PORT=3120
# AGENTSTUDIO_API_PORT=8120
# AGENTSTUDIO_PG_PORT=5452
# AGENTSTUDIO_REDIS_PORT=6412
# AGENTSTUDIO_FLOCI_PORT=4612
# AGENTSTUDIO_WORKER_METRICS_PORT=9120
# AGENTSTUDIO_OFFLINE_DELAY_MS=150

# Optional real models: an OpenAI-compatible endpoint and/or Ollama.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OLLAMA_URL=http://host.docker.internal:11434
