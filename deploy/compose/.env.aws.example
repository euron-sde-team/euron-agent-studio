# Real AWS resources for `make up-aws`. Values come from the Terraform outputs of
# infra/terraform/envs/aws-dev (or your own bucket, key and queue).
AWS_REGION=us-east-1
STORAGE_BACKEND=s3
S3_BUCKET=agentstudio-dev-knowledge
S3_KMS_KEY_ID=alias/agentstudio-dev
QUEUE_BACKEND=sqs
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/agentstudio-dev-runs
